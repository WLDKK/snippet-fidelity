{
  "$schema": "../schema/config.schema.json",
  "version": 1,
  "baseUrl": "http://127.0.0.1:4173/",
  "browser": { "timeoutMs": 5000 },
  "pages": [
    {
      "url": "/",
      "checks": [
        {
          "id": "good-unicode",
          "button": "#copy-good-unicode",
          "expected": { "text": "printf '你好 👋 — café'" },
          "probe": "both"
        },
        {
          "id": "trailing-newline",
          "button": "#copy-trailing-newline",
          "expected": { "text": "npm install safe-package" },
          "probe": "both"
        },
        {
          "id": "indentation-loss",
          "button": "#copy-indentation-loss",
          "expected": { "text": "if (ready) {\n\tlaunch();\n}" },
          "probe": "both"
        },
        {
          "id": "tabs-to-spaces",
          "button": "#copy-tabs-to-spaces",
          "expected": { "text": "root\n\tchild" },
          "probe": "both"
        },
        {
          "id": "zero-width-injection",
          "button": "#copy-zero-width-injection",
          "expected": { "text": "const token = 'safe';" },
          "probe": "both"
        },
        {
          "id": "unicode-normalization",
          "button": "#copy-unicode-normalization",
          "expected": { "text": "const label = 'café';" },
          "probe": "both"
        }
      ]
    }
  ]
}
