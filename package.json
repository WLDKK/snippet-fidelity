{
  "name": "snippet-fidelity",
  "version": "0.4.0",
  "description": "Test documentation copy buttons for newline, whitespace, Unicode, and clipboard corruption.",
  "type": "module",
  "bin": {
    "snippet-fidelity": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "fixtures",
    "schema",
    "scripts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dist:check": "pnpm build && git diff --exit-code -- dist",
    "fixture": "node scripts/serve-fixture.mjs",
    "fixture:verify": "node scripts/verify-fixture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/audit.e2e.test.ts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && npm pack --dry-run --cache artifacts/npm-cache",
    "release:check": "pnpm verify && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm release:check",
    "prepack": "pnpm build"
  },
  "keywords": [
    "clipboard",
    "copy-button",
    "documentation",
    "documentation-testing",
    "github-actions",
    "playwright",
    "testing",
    "unicode",
    "whitespace",
    "code-blocks"
  ],
  "author": "Lidong Wang",
  "license": "MIT",
  "homepage": "https://github.com/WLDKK/snippet-fidelity#readme",
  "bugs": {
    "url": "https://github.com/WLDKK/snippet-fidelity/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WLDKK/snippet-fidelity.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
