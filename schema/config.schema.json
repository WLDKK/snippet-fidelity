{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snippet Fidelity configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pages"],
  "properties": {
    "version": { "const": 1 },
    "baseUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headless": { "type": "boolean" },
        "timeoutMs": { "$ref": "#/$defs/timeout" }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "timeout": { "type": "integer", "minimum": 1, "maximum": 120000 },
    "probe": { "enum": ["clipboard", "handler", "both"] },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector"],
          "properties": { "selector": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "button", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "button": { "type": "string", "minLength": 1 },
        "expected": { "$ref": "#/$defs/expected" },
        "probe": { "$ref": "#/$defs/probe" },
        "timeoutMs": { "$ref": "#/$defs/timeout" }
      }
    },
    "discover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockSelector": { "type": "string", "minLength": 1 },
        "codeSelector": { "type": "string", "minLength": 1 },
        "buttonSelector": { "type": "string", "minLength": 1 },
        "buttonNamePattern": { "type": "string", "minLength": 1 },
        "ancestorDepth": { "type": "integer", "minimum": 0, "maximum": 6 },
        "probe": { "$ref": "#/$defs/probe" },
        "timeoutMs": { "$ref": "#/$defs/timeout" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        },
        "discover": { "$ref": "#/$defs/discover" }
      },
      "oneOf": [{ "required": ["checks"] }, { "required": ["discover"] }]
    }
  }
}
